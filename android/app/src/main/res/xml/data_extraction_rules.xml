<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's own privacy policy says data leaves the phone only when the user exports a
  backup themselves. Android Auto Backup was quietly contradicting that: it copied the
  unencrypted database - names, phone numbers, the whole debt ledger, and the passwords
  people are invited to keep here - to Google Drive with no one asking.

  Preferences and the widget's state can go; the records cannot. A user who wants their
  data on another phone has the in-app encrypted export, which is theirs to hand over.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="database" />
    <exclude domain="file" path="attachments/" />
    <exclude domain="sharedpref" path="appLock.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="database" />
    <exclude domain="file" path="attachments/" />
  </device-transfer>
</data-extraction-rules>
