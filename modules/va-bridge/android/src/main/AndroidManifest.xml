<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.SEND_SMS" />
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Reads the notifications of the chat apps the owner chose (WhatsApp, Messenger, IMO, ...). The owner turns this on in Settings. -->
    <service
      android:name="expo.modules.vabridge.VaNotificationListener"
      android:exported="true"
      android:label="সুমনের ভার্চুয়াল সহকারী"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Keeps the phone and the server in step: uploads what arrived, runs what the server asks (alerts, replies, SMS). -->
    <service
      android:name="expo.modules.vabridge.PollService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <receiver android:name="expo.modules.vabridge.SmsReceiver" android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter android:priority="999">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>

    <receiver android:name="expo.modules.vabridge.CallReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PHONE_STATE" />
      </intent-filter>
    </receiver>

    <receiver android:name="expo.modules.vabridge.SmsStatusReceiver" android:exported="false">
      <intent-filter>
        <action android:name="expo.modules.vabridge.SMS_SENT" />
        <action android:name="expo.modules.vabridge.SMS_DELIVERED" />
      </intent-filter>
    </receiver>

    <receiver android:name="expo.modules.vabridge.BootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
